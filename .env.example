# Template das variáveis de ambiente do docker-compose.
# Copie para .env e preencha com valores reais.
# --- Postgres do auth-service ---
AUTH_DB_USER=
AUTH_DB_PASSWORD=
AUTH_DB_NAME=auth_db
AUTH_MASTER_KEY=

# --- Postgres compartilhado (flag + targeting) ---
SHARED_DB_USER=
SHARED_DB_PASSWORD=
FLAG_DB_NAME=flag_db
TARGETING_DB_NAME=targeting_db

# --- evaluation-service ---
SERVICE_API_KEY=

# --- analytics-service (valores locais/dummy) ---
AWS_REGION=us-east-1
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ANALYTICS_SQS_URL=
